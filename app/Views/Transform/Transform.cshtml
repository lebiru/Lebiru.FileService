@model Lebiru.FileService.Models.TransformViewModel

@{
    ViewData["Title"] = "Transform";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>Transform Sources</h2>
            <p class="text-muted">Configure and manage your file transformations</p>
        </div>
        <div class="col-auto">
            <a href="@Url.Action("AddTransform", "Transform")" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Transform
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (!Model.TransformSources.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> You haven't configured any transform sources yet. 
            <a href="@Url.Action("AddTransform", "Transform")" class="alert-link">Add your first transform source</a> to start transforming files.
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Your Transform Sources</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>File Pattern</th>
                            <th>Status</th>
                            <th>Last Executed</th>
                            <th>Files Processed</th>
                            <th>Schedule</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var source in Model.TransformSources)
                        {
                            <tr>
                                <td>@source.Title</td>
                                <td><code>@source.FilePattern</code></td>
                                <td>
                                    @if (source.IsActive)
                                    {
                                        <span class="badge badge-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @if (source.LastExecutedTime.HasValue)
                                    {
                                        @source.LastExecutedTime.Value.ToString("yyyy-MM-dd HH:mm:ss.fff")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Never</span>
                                    }
                                </td>
                                <td>
                                    @if (source.LastProcessedFileCount.HasValue)
                                    {
                                        @source.LastProcessedFileCount.Value
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td>
                                    @if (source.IsActive)
                                    {
                                        <span>Every @source.TransformIntervalMinutes minutes</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Disabled</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a href="/Transform/EditTransform/@source.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-secondary test-transform-btn" data-id="@source.Id">
                                            <i class="fas fa-plug"></i> Test
                                        </button>
                                        <form method="post" action="@Url.Action("ExecuteTransform", "Transform")" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="transformId" value="@source.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="fas fa-play"></i> Run Now
                                            </button>
                                        </form>
                                        <form method="post" action="@Url.Action("DeleteTransform", "Transform")" 
                                              onsubmit="return confirm('Are you sure you want to delete this transform source?');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="transformId" value="@source.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0">Recent Transform Activities</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Transform</th>
                            <th>Status</th>
                            <th>Message</th>
                            <th>Files Processed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var activity in Model.LatestActivities)
                        {
                            <tr>
                                <td>@activity.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                                <td>@activity.TransformTitle</td>
                                <td>
                                    @switch (activity.Status)
                                    {
                                        case Lebiru.FileService.Models.TransformStatus.InProgress:
                                            <span class="badge badge-info">In Progress</span>
                                            break;
                                        case Lebiru.FileService.Models.TransformStatus.Success:
                                            <span class="badge badge-success">Success</span>
                                            break;
                                        case Lebiru.FileService.Models.TransformStatus.Failed:
                                            <span class="badge badge-danger">Failed</span>
                                            break;
                                        default:
                                            <span class="badge badge-secondary">Not Executed</span>
                                            break;
                                    }
                                </td>
                                <td>@activity.Message</td>
                                <td>@activity.FilesProcessed</td>
                            </tr>
                        }

                        @if (!Model.LatestActivities.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-3">
                                    <i class="fas fa-info-circle text-muted"></i> 
                                    No transform activities recorded yet. Run a transform to see results here.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(function() {
            // Handle test transform button click
            $('.test-transform-btn').click(function() {
                var sourceId = $(this).data('id');
                var button = $(this);
                
                // Disable button and show spinner
                button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Testing');
                
                // Send AJAX request to test the transform
                $.post('@Url.Action("TestTransform", "Transform")', { transformId: sourceId })
                    .done(function(data) {
                        if (data.success) {
                            // Show success notification
                            showNotification('success', data.message);
                        } else {
                            // Show error notification
                            showNotification('danger', data.message || 'Transform test failed.');
                        }
                    })
                    .fail(function() {
                        // Show error notification
                        showNotification('danger', 'Transform test failed. Please try again later.');
                    })
                    .always(function() {
                        // Re-enable button and restore text
                        button.prop('disabled', false).html('<i class="fas fa-plug"></i> Test');
                    });
            });
            
            // Function to show notifications
            function showNotification(type, message) {
                // Remove any existing notifications
                $('.alert').alert('close');
                
                // Create the notification
                var alertHtml = 
                    '<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert">' +
                        message +
                        '<button type="button" class="close" data-dismiss="alert" aria-label="Close">' +
                            '<span aria-hidden="true">&times;</span>' +
                        '</button>' +
                    '</div>';
                
                // Insert at the top of the content area
                $('.container').prepend(alertHtml);
                
                // Auto-hide after 5 seconds
                setTimeout(function() {
                    $('.alert').alert('close');
                }, 5000);
            }
        });
    </script>
}