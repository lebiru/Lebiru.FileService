@{
    ViewData["Title"] = "Destinations";
    Layout = "_Layout";
}

<div class="container mt-4 destinations-page" aria-labelledby="destinations-title">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 id="destinations-title">Destinations</h2>
            <p class="text-muted mb-0">Configure and manage where your files are delivered.</p>
        </div>
        <div class="col-auto mt-3 mt-sm-0">
            <button class="btn btn-primary" type="button" id="newDestinationButton">
                <i class="fas fa-plus" aria-hidden="true"></i> Add New Destination
            </button>
        </div>
    </div>

    <div id="destinationAlert" aria-live="polite"></div>

    <div id="destinationLoading" class="card mb-4">
        <div class="card-body text-center py-5 text-muted" role="status">
            <i class="fas fa-circle-notch fa-spin mr-2" aria-hidden="true"></i> Loading destinations…
        </div>
    </div>

    <div id="destinationEmpty" class="alert alert-info d-none" role="status">
        <i class="fas fa-info-circle" aria-hidden="true"></i>
        You haven’t configured any destinations yet.
        <button type="button" class="alert-link destination-inline-button" id="emptyCreateButton">Add your first destination</button>
        to start sending managed files.
    </div>

    <div id="destinationList" class="card mb-4 d-none">
        <div class="card-header bg-light d-flex align-items-center justify-content-between">
            <h5 class="mb-0">Your Destinations</h5>
            <span class="text-muted small" id="destinationCount"></span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Type</th>
                        <th scope="col">Status</th>
                        <th scope="col">Connection</th>
                        <th scope="col">Credentials</th>
                        <th scope="col">Updated</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody id="destinationRows"></tbody>
            </table>
        </div>
    </div>

    <div class="card destination-help-card">
        <div class="card-body d-flex align-items-start">
            <span class="destination-help-icon"><i class="fas fa-shield-alt" aria-hidden="true"></i></span>
            <div>
                <h5 class="mb-1">Secure outbound delivery</h5>
                <p class="text-muted mb-0">Credentials are encrypted at rest and never displayed after saving. Deliveries retain safe status history without exposing secrets.</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="destinationModal" tabindex="-1" aria-labelledby="destinationModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form id="destinationForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title h5 mb-1" id="destinationModalTitle">Add New Destination</h2>
                        <p class="text-muted small mb-0">Choose a delivery type and enter its connection details.</p>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="destinationId" />
                    <div class="form-row">
                        <div class="form-group col-md-8">
                            <label for="destinationName">Destination name</label>
                            <input id="destinationName" class="form-control" maxlength="100" placeholder="Production Archive" required />
                        </div>
                        <div class="form-group col-md-4">
                            <label for="destinationType">Destination type</label>
                            <select id="destinationType" class="form-control">
                                <option value="S3">S3</option>
                                <option value="Email">Email</option>
                                <option value="Ftp">FTP / FTPS</option>
                            </select>
                        </div>
                    </div>
                    <div class="custom-control custom-switch mb-4">
                        <input type="checkbox" class="custom-control-input" id="destinationEnabled" checked />
                        <label class="custom-control-label" for="destinationEnabled">Destination enabled</label>
                    </div>
                    <div id="destinationFields"></div>
                    <div class="alert alert-info destination-credential-note mb-0">
                        <i class="fas fa-lock mr-1" aria-hidden="true"></i>
                        Credentials are encrypted and never returned. When editing, leave credential fields blank to retain the saved values.
                    </div>
                    <div id="destinationFormError" class="alert alert-danger d-none mt-3 mb-0" role="alert"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit" id="saveDestinationButton"><i class="fas fa-save" aria-hidden="true"></i> Save Destination</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
<style>
    .destinations-page { width: 100%; }
    .destination-inline-button { padding: 0; border: 0; background: transparent; color: inherit; font: inherit; font-weight: 700; text-decoration: underline; }
    .destination-name { display: flex; align-items: center; gap: .7rem; min-width: 190px; }
    .destination-type-icon { display: inline-grid; place-items: center; flex: 0 0 auto; width: 34px; height: 34px; color: #554cdb; background: rgba(99, 91, 255, .1); border-radius: 10px; }
    .destination-actions { min-width: 260px; }
    .destination-actions .btn { white-space: nowrap; }
    .destination-help-card .card-body { gap: 1rem; }
    .destination-help-icon { display: inline-grid; place-items: center; flex: 0 0 auto; width: 42px; height: 42px; color: #08744a; background: #d9f7e9; border-radius: 12px; }
    .destination-section-title { display: flex; align-items: center; gap: .5rem; margin: .35rem 0 1rem; padding-bottom: .65rem; border-bottom: 1px solid var(--line); font-size: .95rem; }
    .destination-section-title:not(:first-child) { margin-top: .75rem; }
    .destination-credential-note { box-shadow: none; }
    .destination-last-test { white-space: nowrap; }
    body.dark-mode .destination-type-icon { color: #b9b5ff; background: rgba(124, 114, 255, .16); }
    body.dark-mode .destination-help-icon { color: #67d6aa; background: rgba(18, 166, 106, .16); }
    body.dark-mode .destination-inline-button { color: #8ed9eb; }
    @@media (max-width: 575.98px) {
        .destinations-page > .row { align-items: flex-start !important; }
        .destinations-page > .row .col-auto, .destinations-page > .row .btn { width: 100%; }
        .destination-actions { min-width: 210px; }
    }
</style>
}

@section Scripts {
<script>
(() => {
    const destinationTypes = ['S3', 'Email', 'FTP'];
    const typeValues = ['S3', 'Email', 'Ftp'];
    const typeIcons = ['fa-cloud', 'fa-envelope', 'fa-server'];
    const fieldTemplates = {
        S3: `
            <h3 class="destination-section-title"><i class="fas fa-cog" aria-hidden="true"></i> S3 configuration</h3>
            <div class="form-row">
                <div class="form-group col-md-7"><label for="s3Bucket">Bucket</label><input id="s3Bucket" class="form-control" data-config="bucket" placeholder="company-files" required></div>
                <div class="form-group col-md-5"><label for="s3Region">Region</label><input id="s3Region" class="form-control" data-config="region" value="us-east-1" required></div>
            </div>
            <div class="form-group"><label for="s3Prefix">Object prefix <span class="text-muted">(optional)</span></label><input id="s3Prefix" class="form-control" data-config="prefix" placeholder="reports/"></div>
            <h3 class="destination-section-title"><i class="fas fa-key" aria-hidden="true"></i> Credentials</h3>
            <div class="form-row">
                <div class="form-group col-md-6"><label for="s3AccessKey">Access key</label><input id="s3AccessKey" class="form-control" data-secret="accessKey" autocomplete="off"></div>
                <div class="form-group col-md-6"><label for="s3SecretKey">Secret key</label><input id="s3SecretKey" type="password" class="form-control" data-secret="secretKey" autocomplete="new-password"></div>
            </div>
            <div class="form-group"><label for="s3SessionToken">Session token <span class="text-muted">(optional)</span></label><input id="s3SessionToken" type="password" class="form-control" data-secret="sessionToken" autocomplete="new-password"></div>`,
        Email: `
            <h3 class="destination-section-title"><i class="fas fa-envelope" aria-hidden="true"></i> SMTP configuration</h3>
            <div class="form-row">
                <div class="form-group col-md-8"><label for="emailHost">SMTP host</label><input id="emailHost" class="form-control" data-config="host" placeholder="smtp.example.com" required></div>
                <div class="form-group col-md-4"><label for="emailPort">Port</label><input id="emailPort" type="number" min="1" max="65535" class="form-control" data-config="port" value="587" required></div>
            </div>
            <div class="custom-control custom-switch mb-3"><input type="checkbox" class="custom-control-input" id="emailTls" data-config="useTls" checked><label class="custom-control-label" for="emailTls">Require STARTTLS</label></div>
            <div class="form-row">
                <div class="form-group col-md-6"><label for="emailFrom">From address</label><input id="emailFrom" type="email" class="form-control" data-config="from" required></div>
                <div class="form-group col-md-6"><label for="emailTo">Recipient</label><input id="emailTo" type="email" class="form-control" data-config="to" required></div>
            </div>
            <div class="form-group"><label for="emailSubject">Subject</label><input id="emailSubject" class="form-control" maxlength="200" data-config="subject" value="File from Felix File Service"></div>
            <div class="form-group"><label for="emailBody">Message</label><textarea id="emailBody" class="form-control" rows="3" maxlength="10000" data-config="body"></textarea></div>
            <h3 class="destination-section-title"><i class="fas fa-key" aria-hidden="true"></i> Credentials <span class="text-muted small">(optional for anonymous SMTP)</span></h3>
            <div class="form-row">
                <div class="form-group col-md-6"><label for="emailUsername">Username</label><input id="emailUsername" class="form-control" data-secret="username" autocomplete="off"></div>
                <div class="form-group col-md-6"><label for="emailPassword">Password</label><input id="emailPassword" type="password" class="form-control" data-secret="password" autocomplete="new-password"></div>
            </div>`,
        Ftp: `
            <h3 class="destination-section-title"><i class="fas fa-server" aria-hidden="true"></i> FTP / FTPS configuration</h3>
            <div class="form-row">
                <div class="form-group col-md-8"><label for="ftpHost">Host</label><input id="ftpHost" class="form-control" data-config="host" placeholder="ftp.example.com" required></div>
                <div class="form-group col-md-4"><label for="ftpPort">Port</label><input id="ftpPort" type="number" min="1" max="65535" class="form-control" data-config="port" value="21" required></div>
            </div>
            <div class="custom-control custom-switch mb-3"><input type="checkbox" class="custom-control-input" id="ftpTls" data-config="useTls"><label class="custom-control-label" for="ftpTls">Use explicit TLS (FTPS)</label></div>
            <div class="form-group"><label for="ftpRemotePath">Remote directory</label><input id="ftpRemotePath" class="form-control" data-config="remotePath" value="/" required></div>
            <h3 class="destination-section-title"><i class="fas fa-key" aria-hidden="true"></i> Credentials</h3>
            <div class="form-row">
                <div class="form-group col-md-6"><label for="ftpUsername">Username</label><input id="ftpUsername" class="form-control" data-secret="username" autocomplete="off"></div>
                <div class="form-group col-md-6"><label for="ftpPassword">Password</label><input id="ftpPassword" type="password" class="form-control" data-secret="password" autocomplete="new-password"></div>
            </div>`
    };

    const form = document.getElementById('destinationForm');
    const modal = $('#destinationModal');
    const rows = document.getElementById('destinationRows');
    const loading = document.getElementById('destinationLoading');
    const empty = document.getElementById('destinationEmpty');
    const list = document.getElementById('destinationList');
    const formError = document.getElementById('destinationFormError');

    function escapeHtml(value) {
        const node = document.createElement('div');
        node.textContent = value ?? '';
        return node.innerHTML;
    }

    function showAlert(message, type = 'info') {
        document.getElementById('destinationAlert').innerHTML = `
            <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                ${escapeHtml(message)}
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>`;
    }

    async function readProblem(response, fallback) {
        try { const problem = await response.json(); return problem.title || problem.error || fallback; }
        catch { return fallback; }
    }

    function formatDate(value) {
        if (!value) return '<span class="text-muted">Never</span>';
        const date = new Date(value);
        return `<span title="${escapeHtml(date.toLocaleString())}">${escapeHtml(date.toLocaleDateString())}</span>`;
    }

    function connectionBadge(item) {
        if (item.lastTestSucceeded === true) return '<span class="badge badge-success">Connected</span>';
        if (item.lastTestSucceeded === false) return '<span class="badge badge-danger">Test failed</span>';
        return '<span class="badge badge-secondary">Not tested</span>';
    }

    function renderRows(items) {
        rows.innerHTML = items.map(item => `
            <tr>
                <td><div class="destination-name"><span class="destination-type-icon"><i class="fas ${typeIcons[item.type]}" aria-hidden="true"></i></span><strong>${escapeHtml(item.name)}</strong></div></td>
                <td><span class="badge badge-info">${destinationTypes[item.type]}</span></td>
                <td><span class="badge ${item.isEnabled ? 'badge-success' : 'badge-secondary'}">${item.isEnabled ? 'Enabled' : 'Disabled'}</span></td>
                <td class="destination-last-test">${connectionBadge(item)}</td>
                <td>${item.credentialsConfigured ? '<span class="text-success"><i class="fas fa-lock mr-1" aria-hidden="true"></i>Configured</span>' : '<span class="text-danger">Missing</span>'}</td>
                <td>${formatDate(item.updatedAt)}</td>
                <td class="destination-actions">
                    <div class="btn-group btn-group-sm" role="group" aria-label="Destination actions">
                        <button type="button" class="btn btn-outline-primary" data-action="test" data-id="${item.id}"><i class="fas fa-plug" aria-hidden="true"></i> Test</button>
                        <button type="button" class="btn btn-outline-secondary" data-action="edit" data-id="${item.id}"><i class="fas fa-edit" aria-hidden="true"></i> Edit</button>
                        <button type="button" class="btn btn-outline-secondary" data-action="toggle" data-id="${item.id}" data-enabled="${item.isEnabled}">${item.isEnabled ? '<i class="fas fa-pause" aria-hidden="true"></i> Disable' : '<i class="fas fa-play" aria-hidden="true"></i> Enable'}</button>
                        <button type="button" class="btn btn-outline-danger" data-action="delete" data-id="${item.id}"><i class="fas fa-trash" aria-hidden="true"></i><span class="sr-only"> Delete</span></button>
                    </div>
                </td>
            </tr>`).join('');
    }

    async function loadDestinations() {
        loading.classList.remove('d-none'); empty.classList.add('d-none'); list.classList.add('d-none');
        try {
            const response = await fetch('/api/destinations', { cache: 'no-store' });
            if (!response.ok) throw new Error(await readProblem(response, 'Destinations could not be loaded.'));
            const items = await response.json();
            loading.classList.add('d-none');
            if (!items.length) { empty.classList.remove('d-none'); return; }
            document.getElementById('destinationCount').textContent = `${items.length} ${items.length === 1 ? 'destination' : 'destinations'}`;
            renderRows(items); list.classList.remove('d-none');
        } catch (error) { loading.classList.add('d-none'); showAlert(error.message || 'Destinations could not be loaded.', 'danger'); }
    }

    let originalType = null;

    function renderFields(values = {}) {
        const type = document.getElementById('destinationType').value;
        document.getElementById('destinationFields').innerHTML = fieldTemplates[type];
        Object.entries(values).forEach(([key, value]) => {
            const input = document.querySelector(`[data-config="${key}"]`);
            if (!input) return;
            if (input.type === 'checkbox') input.checked = !!value; else input.value = value ?? '';
        });
        const credentialsRequired = !document.getElementById('destinationId').value || (originalType !== null && type !== originalType);
        if (credentialsRequired && type !== 'Email') document.querySelectorAll('[data-secret]').forEach(input => input.required = true);
    }

    function openCreateForm() {
        form.reset(); document.getElementById('destinationId').value = ''; originalType = null;
        document.getElementById('destinationModalTitle').textContent = 'Add New Destination';
        formError.classList.add('d-none'); renderFields(); modal.modal('show');
    }

    async function getDestination(id) {
        const response = await fetch(`/api/destinations/${id}`, { cache: 'no-store' });
        if (!response.ok) throw new Error(await readProblem(response, 'Destination could not be loaded.'));
        return response.json();
    }

    async function editDestination(id) {
        try {
            const item = await getDestination(id);
            form.reset(); document.getElementById('destinationId').value = id;
            document.getElementById('destinationName').value = item.name;
            originalType = typeValues[item.type];
            document.getElementById('destinationType').value = originalType;
            document.getElementById('destinationEnabled').checked = item.isEnabled;
            document.getElementById('destinationModalTitle').textContent = 'Edit Destination';
            formError.classList.add('d-none'); renderFields(item.configuration); modal.modal('show');
        } catch (error) { showAlert(error.message, 'danger'); }
    }

    async function updateEnabled(id, isEnabled) {
        try {
            const item = await getDestination(id);
            const response = await fetch(`/api/destinations/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: item.name, type: item.type, isEnabled, configuration: item.configuration }) });
            if (!response.ok) throw new Error(await readProblem(response, 'Destination status could not be updated.'));
            showAlert(`Destination ${isEnabled ? 'enabled' : 'disabled'} successfully.`, 'success'); await loadDestinations();
        } catch (error) { showAlert(error.message, 'danger'); }
    }

    async function testDestination(id, button) {
        const original = button.innerHTML; button.disabled = true; button.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> Testing';
        try {
            const response = await fetch(`/api/destinations/${id}/test`, { method: 'POST' });
            const result = await response.json();
            if (!response.ok) throw new Error(result.title || 'Connection test failed.');
            showAlert(result.success ? 'Connection test succeeded.' : result.error || 'Connection test failed.', result.success ? 'success' : 'danger'); await loadDestinations();
        } catch (error) { showAlert(error.message, 'danger'); }
        finally { button.disabled = false; button.innerHTML = original; }
    }

    async function deleteDestination(id) {
        if (!confirm('Delete this destination? Delivery history and managed files will be retained.')) return;
        try {
            const response = await fetch(`/api/destinations/${id}`, { method: 'DELETE' });
            if (!response.ok) throw new Error(await readProblem(response, 'Destination could not be deleted.'));
            showAlert('Destination deleted successfully.', 'success'); await loadDestinations();
        } catch (error) { showAlert(error.message, 'danger'); }
    }

    form.addEventListener('submit', async event => {
        event.preventDefault();
        const id = document.getElementById('destinationId').value;
        const configuration = {}, credentials = {};
        document.querySelectorAll('[data-config]').forEach(input => configuration[input.dataset.config] = input.type === 'checkbox' ? input.checked : input.type === 'number' ? Number(input.value) : input.value);
        document.querySelectorAll('[data-secret]').forEach(input => { if (input.value) credentials[input.dataset.secret] = input.value; });
        const payload = { name: document.getElementById('destinationName').value, type: typeValues.indexOf(document.getElementById('destinationType').value), isEnabled: document.getElementById('destinationEnabled').checked, configuration };
        if (!id || document.getElementById('destinationType').value !== originalType || Object.keys(credentials).length) payload.credentials = credentials;
        const saveButton = document.getElementById('saveDestinationButton'); saveButton.disabled = true;
        try {
            const response = await fetch(id ? `/api/destinations/${id}` : '/api/destinations', { method: id ? 'PATCH' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            if (!response.ok) throw new Error(await readProblem(response, 'Destination could not be saved.'));
            modal.modal('hide'); showAlert(`Destination ${id ? 'updated' : 'created'} successfully.`, 'success'); await loadDestinations();
        } catch (error) { formError.textContent = error.message; formError.classList.remove('d-none'); }
        finally { saveButton.disabled = false; }
    });

    rows.addEventListener('click', event => {
        const button = event.target.closest('button[data-action]');
        if (!button) return;
        if (button.dataset.action === 'edit') editDestination(button.dataset.id);
        if (button.dataset.action === 'test') testDestination(button.dataset.id, button);
        if (button.dataset.action === 'toggle') updateEnabled(button.dataset.id, button.dataset.enabled !== 'true');
        if (button.dataset.action === 'delete') deleteDestination(button.dataset.id);
    });

    document.getElementById('destinationType').addEventListener('change', () => renderFields());
    document.getElementById('newDestinationButton').addEventListener('click', openCreateForm);
    document.getElementById('emptyCreateButton').addEventListener('click', openCreateForm);
    loadDestinations();
})();
</script>
}
