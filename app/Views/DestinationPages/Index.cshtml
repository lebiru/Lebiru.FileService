@{ ViewData["Title"] = "Destinations"; }

<main class="destinations-shell">
    <header class="destinations-hero">
        <div><p class="eyebrow">Pipeline output</p><h1>Destinations</h1><p>Send managed files securely to S3, Email, or FTP.</p></div>
        <button class="btn btn-primary" type="button" onclick="openDestinationForm()"><i class="fas fa-plus"></i> New destination</button>
    </header>
    <section id="destinationGrid" class="destination-grid" aria-live="polite"></section>
</main>

<div class="modal fade" id="destinationModal" tabindex="-1" aria-labelledby="destinationTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg"><div class="modal-content">
    <form id="destinationForm">
      <div class="modal-header"><h2 class="modal-title h5" id="destinationTitle">New destination</h2><button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button></div>
      <div class="modal-body">
        <input type="hidden" id="destinationId" />
        <div class="form-row"><div class="form-group col-md-8"><label for="destinationName">Name</label><input id="destinationName" class="form-control" maxlength="100" required /></div>
        <div class="form-group col-md-4"><label for="destinationType">Type</label><select id="destinationType" class="form-control" onchange="renderFields()"><option>S3</option><option>Email</option><option>Ftp</option></select></div></div>
        <div class="custom-control custom-switch mb-3"><input type="checkbox" class="custom-control-input" id="destinationEnabled" checked><label class="custom-control-label" for="destinationEnabled">Enabled</label></div>
        <div id="destinationFields"></div>
        <p class="credential-note"><i class="fas fa-lock"></i> Credentials are encrypted at rest and are never returned. Leave credential fields blank while editing to keep the current values.</p>
        <div id="destinationError" class="alert alert-danger d-none" role="alert"></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Save destination</button></div>
    </form>
  </div></div>
</div>

<style>
.destinations-shell{max-width:1180px;margin:0 auto;padding:1rem 0 3rem}.destinations-hero{display:flex;justify-content:space-between;align-items:center;gap:1.5rem;margin-bottom:1.5rem}.destinations-hero h1{font-size:2.25rem;margin:.1rem 0}.destinations-hero p{margin:0;color:var(--text-secondary,#64748b)}.eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:.75rem;font-weight:800;color:#7c3aed!important}.destination-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:1rem}.destination-card{padding:1.25rem;border:1px solid var(--border-color,rgba(148,163,184,.25));border-radius:18px;background:var(--card-bg,#fff);box-shadow:0 14px 40px rgba(15,23,42,.08)}.destination-card-head{display:flex;justify-content:space-between;gap:1rem}.destination-icon{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,#8b5cf6,#2563eb)}.destination-card h2{font-size:1.05rem;margin:.8rem 0 .2rem}.destination-meta{color:var(--text-secondary,#64748b);font-size:.86rem}.destination-actions{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:1rem}.status-pill{font-size:.72rem;font-weight:700;border-radius:999px;padding:.3rem .55rem;background:#dcfce7;color:#166534}.status-pill.off{background:#e2e8f0;color:#475569}.status-pill.failed{background:#fee2e2;color:#991b1b}.credential-note{padding:.8rem;border-radius:12px;background:rgba(124,58,237,.08);color:var(--text-secondary,#64748b);font-size:.86rem}.empty-destinations{grid-column:1/-1;text-align:center;padding:4rem 1rem;border:1px dashed #94a3b8;border-radius:18px;color:var(--text-secondary,#64748b)}@@media(max-width:700px){.destinations-hero{align-items:flex-start;flex-direction:column}}
</style>

@section Scripts {<script>
const fieldTemplates={
 S3:`<h3 class="h6">S3 configuration</h3><div class="form-row"><div class="form-group col-md-7"><label>Bucket</label><input class="form-control" data-config="bucket" required></div><div class="form-group col-md-5"><label>Region</label><input class="form-control" data-config="region" value="us-east-1" required></div></div><div class="form-group"><label>Object prefix</label><input class="form-control" data-config="prefix" placeholder="reports/"></div><h3 class="h6">Credentials</h3><div class="form-row"><div class="form-group col-md-6"><label>Access key</label><input class="form-control" data-secret="accessKey" autocomplete="off"></div><div class="form-group col-md-6"><label>Secret key</label><input type="password" class="form-control" data-secret="secretKey" autocomplete="new-password"></div></div><div class="form-group"><label>Session token (optional)</label><input type="password" class="form-control" data-secret="sessionToken" autocomplete="new-password"></div>`,
 Email:`<h3 class="h6">SMTP and message</h3><div class="form-row"><div class="form-group col-md-8"><label>SMTP host</label><input class="form-control" data-config="host" required></div><div class="form-group col-md-4"><label>Port</label><input type="number" class="form-control" data-config="port" value="587" required></div></div><div class="custom-control custom-switch mb-3"><input type="checkbox" class="custom-control-input" id="emailTls" data-config="useTls" checked><label class="custom-control-label" for="emailTls">Require STARTTLS</label></div><div class="form-row"><div class="form-group col-md-6"><label>From</label><input type="email" class="form-control" data-config="from" required></div><div class="form-group col-md-6"><label>Recipient</label><input type="email" class="form-control" data-config="to" required></div></div><div class="form-group"><label>Subject</label><input class="form-control" maxlength="200" data-config="subject" value="File from Felix File Service"></div><div class="form-group"><label>Body</label><textarea class="form-control" maxlength="10000" data-config="body"></textarea></div><h3 class="h6">Credentials</h3><div class="form-row"><div class="form-group col-md-6"><label>Username</label><input class="form-control" data-secret="username" autocomplete="off"></div><div class="form-group col-md-6"><label>Password</label><input type="password" class="form-control" data-secret="password" autocomplete="new-password"></div></div>`,
 Ftp:`<h3 class="h6">FTP / FTPS configuration</h3><div class="form-row"><div class="form-group col-md-8"><label>Host</label><input class="form-control" data-config="host" required></div><div class="form-group col-md-4"><label>Port</label><input type="number" class="form-control" data-config="port" value="21" required></div></div><div class="custom-control custom-switch mb-3"><input type="checkbox" class="custom-control-input" id="ftpTls" data-config="useTls"><label class="custom-control-label" for="ftpTls">Explicit TLS (FTPS)</label></div><div class="form-group"><label>Remote directory</label><input class="form-control" data-config="remotePath" value="/" required></div><h3 class="h6">Credentials</h3><div class="form-row"><div class="form-group col-md-6"><label>Username</label><input class="form-control" data-secret="username" autocomplete="off"></div><div class="form-group col-md-6"><label>Password</label><input type="password" class="form-control" data-secret="password" autocomplete="new-password"></div></div>`};
function renderFields(values={}){const type=document.getElementById('destinationType').value;document.getElementById('destinationFields').innerHTML=fieldTemplates[type];Object.entries(values).forEach(([key,value])=>{const input=document.querySelector(`[data-config="${key}"]`);if(input){if(input.type==='checkbox')input.checked=!!value;else input.value=value??'';}})}
function openDestinationForm(){document.getElementById('destinationForm').reset();document.getElementById('destinationId').value='';document.getElementById('destinationTitle').textContent='New destination';renderFields();$('#destinationModal').modal('show')}
async function loadDestinations(){const response=await fetch('/api/destinations');const items=await response.json();const grid=document.getElementById('destinationGrid');if(!items.length){grid.innerHTML='<div class="empty-destinations"><i class="fas fa-paper-plane fa-2x mb-3"></i><h2 class="h5">No destinations yet</h2><p>Create an S3, Email, or FTP destination to send files externally.</p></div>';return}grid.innerHTML=items.map(item=>`<article class="destination-card"><div class="destination-card-head"><div class="destination-icon"><i class="fas ${item.type===0?'fa-cloud':item.type===1?'fa-envelope':'fa-server'}"></i></div><span class="status-pill ${!item.isEnabled?'off':item.lastTestSucceeded===false?'failed':''}">${!item.isEnabled?'Disabled':item.lastTestSucceeded===false?'Test failed':'Enabled'}</span></div><h2>${escapeHtml(item.name)}</h2><p class="destination-meta">${['S3','Email','FTP'][item.type]} · ${item.credentialsConfigured?'Credentials configured':'Credentials missing'}</p><div class="destination-actions"><button class="btn btn-sm btn-outline-primary" onclick="editDestination('${item.id}')">Edit</button><button class="btn btn-sm btn-outline-secondary" onclick="testDestination('${item.id}')">Test</button><button class="btn btn-sm btn-outline-danger" onclick="deleteDestination('${item.id}')">Delete</button></div></article>`).join('')}
async function editDestination(id){const item=await (await fetch(`/api/destinations/${id}`)).json();document.getElementById('destinationId').value=id;document.getElementById('destinationName').value=item.name;document.getElementById('destinationType').value=['S3','Email','Ftp'][item.type];document.getElementById('destinationEnabled').checked=item.isEnabled;document.getElementById('destinationTitle').textContent='Edit destination';renderFields(item.configuration);$('#destinationModal').modal('show')}
document.getElementById('destinationForm').addEventListener('submit',async event=>{event.preventDefault();const id=document.getElementById('destinationId').value;const config={},credentials={};document.querySelectorAll('[data-config]').forEach(input=>config[input.dataset.config]=input.type==='checkbox'?input.checked:input.type==='number'?Number(input.value):input.value);document.querySelectorAll('[data-secret]').forEach(input=>{if(input.value)credentials[input.dataset.secret]=input.value});const payload={name:document.getElementById('destinationName').value,type:['S3','Email','Ftp'].indexOf(document.getElementById('destinationType').value),isEnabled:document.getElementById('destinationEnabled').checked,configuration:config};if(!id||Object.keys(credentials).length)payload.credentials=credentials;const response=await fetch(id?`/api/destinations/${id}`:'/api/destinations',{method:id?'PATCH':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!response.ok){const problem=await response.json();const error=document.getElementById('destinationError');error.textContent=problem.title||'Destination could not be saved.';error.classList.remove('d-none');return}$('#destinationModal').modal('hide');await loadDestinations()});
async function testDestination(id){const response=await fetch(`/api/destinations/${id}/test`,{method:'POST'});const result=await response.json();showNotification(result.success?'Connection test succeeded':result.error||'Connection test failed',result.success?'success':'error');await loadDestinations()}
async function deleteDestination(id){if(!confirm('Delete this destination? Delivery history and files will be retained.'))return;const response=await fetch(`/api/destinations/${id}`,{method:'DELETE'});if(response.ok)await loadDestinations()}
function escapeHtml(value){const node=document.createElement('div');node.textContent=value;return node.innerHTML}loadDestinations();
</script>}
