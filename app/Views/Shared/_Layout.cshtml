<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Felix File Service</title>
    <meta name="theme-color" content="#111827" />
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="icon" href="@Url.Content("~/images/favicon.ico")" />
    <style>
        /* Hide scrollbar for Chrome, Safari and Opera */
        ::-webkit-scrollbar {
            display: none;
        }

        /* Hide scrollbar for IE, Edge and Firefox */
        html {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;     /* Firefox */
        }

        .footer-container {
            margin-top: 10px;
        }

        .footer-bottom {
            margin: 0px 0px 50px 0px;
            margin-left: 200px; /* Match the sidebar width */
            width: calc(100% - 200px); /* Match main-content width */
            background-color: #ffffff;
        }

        /* Sidebar styles */
        .sidebar {
            width: 200px;
            height: 100vh;
            position: fixed;
            top: 56px; /* Navbar height */
            left: 0;
            background-color: #f7f7f7;
            color: #333;
            overflow: hidden;
            z-index: 100;
            box-shadow: 2px 0 5px rgba(0,0,0,0.1);
            bottom: 0;
        }

        .sidebar.expanded {
            width: 200px;
        }

        .sidebar-header {
            padding: 15px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .sidebar-toggle {
            cursor: pointer;
            font-size: 24px;
            color: #007bff;
            background-color: rgba(0, 0, 0, 0.05);
            padding: 8px;
            border-radius: 50%;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.2);
        }

        .sidebar-content {
            padding: 15px 0;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            color: #333;
            text-decoration: none;
            transition: background-color 0.2s;
            white-space: nowrap;
        }

        .sidebar-item:hover {
            background-color: rgba(0, 0, 0, 0.05); /* Subtle dark hover */
            color: #007bff; /* Bootstrap primary blue */
            text-decoration: none;
        }

        .sidebar-item i {
            font-size: 18px;
            width: 30px;
            text-align: center;
        }

        .sidebar-text {
            margin-left: 10px;
            opacity: 1;
        }

        .main-content {
            margin-left: 200px;
            width: calc(100% - 200px);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-left: 50px;
            padding-right: 50px;
        }
        
        .main-content > * {
            width: 100%;
            max-width: 100%;
        }
        
        /* All pages use full width */
        .main-content > * {
            max-width: 100%;
        }

        /* Shine effect for toggle */
        @@keyframes shine {
            0% {
                background-position: -100px;
            }
            20% {
                background-position: 200px;
            }
            100% {
                background-position: 200px;
            }
        }

        .sidebar-toggle.shine {
            position: relative;
            overflow: hidden;
        }

        .sidebar-toggle.shine::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.3) 50%, rgba(255,255,255,0) 100%);
            background-size: 100px 100%;
            transform: rotate(45deg);
            animation: shine 1s ease-in-out;
            pointer-events: none;
        }

        /* Dark mode support for sidebar */
        body.dark-mode .sidebar {
            background-color: #222;
            color: #f7f7f7;
            border-right: 1px solid #333;
        }
        
        body.dark-mode .sidebar-item {
            color: #f7f7f7;
        }

        body.dark-mode .sidebar-item:hover {
            background-color: rgba(255, 255, 255, 0.1);
            color: #00ffff;
        }
        
        /* Dark mode support for footer */
        body.dark-mode .footer-bottom {
            background-color: #222 !important;
            color: #f7f7f7;
        }
        
        /* Dark mode support for navbar */
        body.dark-mode .navbar {
            background-color: #222 !important;
        }
        
        body.dark-mode .navbar-light .navbar-brand,
        body.dark-mode .navbar-light .navbar-nav .nav-link {
            color: #f7f7f7;
        }

    </style>
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="@(ViewContext.RouteData.Values["action"]?.ToString()?.ToLower() == "index" ? "page-home" : "") @(ViewContext.RouteData.Values["action"]?.ToString()?.ToLower() == "swagger" || Context.Request.Path.Value?.ToLower().Contains("swagger") == true ? "page-swagger" : "")">
    <header style="position: sticky; top: 0; z-index: 1020;">
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <div class="container-fluid">
                <a class="navbar-brand mr-auto" href="/File/Home" aria-label="Felix File Service dashboard">
                    <span class="brand-mark"><i class="fas fa-layer-group" aria-hidden="true"></i></span>
                    <span class="brand-copy"><strong>Felix</strong><small>File Service</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/File/Swagger"><i class="fas fa-code" aria-hidden="true"></i> API</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/healthz"><i class="fas fa-heartbeat" aria-hidden="true"></i> Health</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Telemetry"><i class="fas fa-chart-line" aria-hidden="true"></i> Telemetry</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/hangfire"><i class="fas fa-tasks" aria-hidden="true"></i> Jobs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Config/View"><i class="fas fa-sliders-h" aria-hidden="true"></i> Settings</a>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link user-chip">
                                <i class="fas fa-user-circle" aria-hidden="true"></i> @User.Identity?.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <form method="post" action="/Auth/Logout" class="logout-form">
                                @Html.AntiForgeryToken()
                                <button class="nav-link logout-link" type="submit"><i class="fas fa-sign-out-alt" aria-hidden="true"></i><span class="sr-only">Logout</span></button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="d-flex">
        <!-- Sidebar -->
        <aside id="sidebar" class="sidebar" aria-label="Primary navigation">
            <div class="sidebar-content">
                <div class="sidebar-label">Workspace</div>
                <a href="/File/Home" class="sidebar-item">
                    <i class="fas fa-home"></i>
                    <span class="sidebar-text">Overview</span>
                </a>
                <a href="/File/Upload" class="sidebar-item">
                    <i class="fas fa-upload"></i>
                    <span class="sidebar-text">Upload</span>
                </a>
                <a href="/File/Fetch" class="sidebar-item">
                    <i class="fas fa-cloud-download-alt"></i>
                    <span class="sidebar-text">Sources</span>
                </a>
                <a href="/Transform" class="sidebar-item">
                    <i class="fas fa-magic"></i>
                    <span class="sidebar-text">Transform</span>
                </a>
            </div>
            <!-- Sidebar toggle removed as sidebar is now permanently expanded -->
        </aside>

        <!-- Main Content -->
        <div class="main-content">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer text-muted footer-bottom">
        <div class="container-fluid footer-container py-3 my-3">
            <span>&copy; @DateTime.Now.Year Felix File Service</span>
            <span class="footer-version">Version @ViewContext.HttpContext.Items["Version"] · @ViewContext.HttpContext.Items["GitCommit"]</span>
        </div>
    </footer>
    
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment-timezone/0.5.43/moment-timezone-with-data.min.js"></script>
    
    <script>
        // Sidebar is now permanently expanded, no toggle functionality needed
        // This script is kept as a placeholder in case we need to add sidebar functionality in the future
        document.addEventListener('DOMContentLoaded', () => {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (!token) return;
            document.querySelectorAll('form').forEach(form => {
                if ((form.method || '').toLowerCase() === 'post' && !form.querySelector('input[name="__RequestVerificationToken"]')) {
                    const input = document.createElement('input'); input.type = 'hidden';
                    input.name = '__RequestVerificationToken'; input.value = token; form.appendChild(input);
                }
            });
            if (window.jQuery) $.ajaxSetup({ headers: { RequestVerificationToken: token } });
            const originalFetch = window.fetch;
            window.fetch = (input, init = {}) => {
                const method = (init.method || 'GET').toUpperCase();
                if (!['GET', 'HEAD', 'OPTIONS', 'TRACE'].includes(method)) {
                    init.headers = new Headers(init.headers || {});
                    init.headers.set('RequestVerificationToken', token);
                }
                return originalFetch(input, init);
            };
            const originalOpen = XMLHttpRequest.prototype.open;
            const originalSend = XMLHttpRequest.prototype.send;
            XMLHttpRequest.prototype.open = function(method, ...args) { this.__method = method; return originalOpen.call(this, method, ...args); };
            XMLHttpRequest.prototype.send = function(...args) {
                if (!['GET', 'HEAD', 'OPTIONS', 'TRACE'].includes((this.__method || 'GET').toUpperCase())) this.setRequestHeader('RequestVerificationToken', token);
                return originalSend.apply(this, args);
            };
        });
    </script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>
